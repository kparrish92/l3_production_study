library(MKinfer)
l2_df <- read.csv(here::here("data", "tidy", "l2_subset.csv"))
l1_df <- read.csv(here::here("data", "tidy", "non_l2_subset.csv"))
all_df = rbind(l1_df, l2_df) %>%
mutate(sig = ifelse(fr_sp_p < .05, 1, 0))
sig_df = all_df %>%
filter(sig == 0)
ppt_list = unique(sig_df$participant)
this_df = sig_df %>%
filter(participant == ppt_list[i])
i = 1
this_df = sig_df %>%
filter(participant == ppt_list[i])
sig_df = all_df %>%
filter(sig == 0) %>%
filter(language == "spanish" | language == "french")
View(sig_df)
this_df = sig_df %>%
filter(participant == ppt_list[i])
boot.t.test(vot~language, data = this_df)
res = boot.t.test(vot~language, data = this_df)
View(res)
res[["parameter"]]
res[["statistic"]]
list = list()
res[["estimate"]]
res[["p.value"]]
data.frame(boot = res[["boot.p.value"]], res[["p.value"]])
list = list()
for i in 1:length(ppt_list)
list = list()
for (i in 1:length(ppt_list))
{
this_df = sig_df %>%
filter(participant == ppt_list[i])
res = boot.t.test(vot~language, data = this_df)
list[i] = data.frame(boot = res[["boot.p.value"]], reg = res[["p.value"]])
}
do.call(rbind, list)
changes = do.call(rbind, list)
changes = do.call(rbind, list) %>%
as.data.frame()
View(changes)
data.frame(boot = res[["boot.p.value"]], reg = res[["p.value"]])
View(list)
list[[1]]
list = list()
for (i in 1:length(ppt_list))
{
this_df = sig_df %>%
filter(participant == ppt_list[i])
res = boot.t.test(vot~language, data = this_df)
list[[i]] = data.frame(boot = res[["boot.p.value"]], reg = res[["p.value"]])
}
changes = do.call(rbind, list) %>%
as.data.frame()
View(changes)
